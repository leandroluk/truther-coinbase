{
  "name": "@repo/nest-auth",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:tsc": "tsc -b -w",
    "dev:alias": "dev-alias-w",
    "dev": "dev-scripts",
    "build": "tsc -p tsconfig.build.json && dev-alias",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@repo/config-eslint": "workspace:^",
    "@repo/config-jest": "workspace:^",
    "@repo/config-typescript": "workspace:^",
    "@tools/dev": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-openidconnect": "^0.1.3",
    "jest": "^30.0.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.45.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@repo/domain": "workspace:^",
    "@repo/nest-cache": "workspace:^",
    "@repo/nest-common": "workspace:^",
    "@repo/nest-crypto": "workspace:^",
    "@repo/nest-database": "workspace:^",
    "@repo/nest-logger": "workspace:^",
    "axios": "^1.10.0",
    "date-fns": "^4.1.0",
    "joi": "^17.13.3",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-openidconnect": "^0.1.2",
    "rxjs": "^7.8.2"
  }
}