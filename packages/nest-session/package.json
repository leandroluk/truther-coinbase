{
  "name": "@repo/nest-session",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:tsc": "tsc -b -w",
    "dev:alias": "dev-alias-w",
    "dev": "dev-scripts",
    "build": "tsc -p tsconfig.build.json && dev-alias",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:^",
    "@repo/config-jest": "workspace:^",
    "@repo/config-typescript": "workspace:^",
    "@tools/dev": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "jest": "^30.0.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@repo/nest-cache": "workspace:^",
    "@repo/nest-common": "workspace:^",
    "@repo/nest-crypto": "workspace:^",
    "@repo/nest-logger": "workspace:^",
    "@nestjs/common": "^11.1.3",
    "@repo/domain": "workspace:^",
    "date-fns": "^4.1.0",
    "joi": "^17.13.3",
    "ms": "^2.1.3"
  }
}