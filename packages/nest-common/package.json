{
  "name": "@repo/nest-common",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:tsc": "tsc -b -w",
    "dev:alias": "dev-alias-w",
    "dev": "dev-scripts",
    "build": "tsc -p tsconfig.build.json && dev-alias",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:^",
    "@repo/config-jest": "workspace:^",
    "@repo/config-typescript": "workspace:^",
    "@tools/dev": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.10",
    "jest": "^30.0.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@repo/nest-logger": "workspace:^",
    "@dotenvx/dotenvx": "^1.45.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@truther-coinbase/domain": "workspace:^",
    "joi": "^17.13.3",
    "ms": "^2.1.3",
    "rxjs": "^7.8.2"
  }
}