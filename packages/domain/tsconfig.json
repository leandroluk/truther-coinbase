{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "dist",
    "paths": {
      "#/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "**/*text.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}